---
/**
 * Nav — 固定顶栏（mix-blend-difference：正文反色时导航自动反转）
 * 左：品牌；右：mono 锚点 + 语言切换。≤760px 锚点收进原生 details
 */
interface Props {
  nav: {
    brand: string;
    links: readonly { label: string; href: string }[];
    langSwitch: { label: string; href: string };
    theme: { dark: string; light: string; auto: string };
  };
}
const { nav } = Astro.props;
---
<header class="nav">
  <div class="container nav-inner">
    <a class="nav-brand" href="#top">{nav.brand}<sup>®</sup></a>

    <nav class="nav-links" aria-label="Main">
      {nav.links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <button class="nav-theme mono" type="button" data-theme-toggle aria-label="Theme" data-labels={JSON.stringify(nav.theme)}>跟随</button>

    <a class="nav-lang mono" href={nav.langSwitch.href} data-lang>{nav.langSwitch.label}</a>

    <details class="nav-more">
      <summary class="mono" aria-label="Menu">MENU</summary>
      <div class="nav-more-panel">
        {nav.links.map((link) => (
          <a class="mono" href={link.href}>{link.label}</a>
        ))}
      </div>
    </details>
  </div>
</header>

<script>
  /* 语言切换带上当前锚点：/ ↔ /en/ 时落在同一区块 */
  const lang = document.querySelector<HTMLAnchorElement>('a[data-lang]');
  lang?.addEventListener('click', () => {
    const url = new URL(lang.href, location.origin);
    url.hash = location.hash;
    lang.href = url.pathname + url.hash;
  });
</script>

<script>
  /* ---------- 主题三态：深色 / 浅色 / 跟随系统 ----------
     生效类 html.light 由 Base.astro head 内联脚本在首绘前打上（防闪）；
     这里只负责切换按钮与后续变更。独立于动效包：reduced-motion 用户也能切。 */
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (btn) {
    const LABELS = JSON.parse(btn.dataset.labels || '{}') as Record<string, string>;
    const ORDER = ['dark', 'light', 'auto'] as const;
    type Mode = (typeof ORDER)[number];
    const media = matchMedia('(prefers-color-scheme: light)');

    const read = (): Mode => {
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light' || t === 'auto') return t;
      } catch { /* 隐私模式等：退回 auto */ }
      return 'auto';
    };

    const effective = (t: Mode): 'light' | 'dark' =>
      t === 'auto' ? (media.matches ? 'light' : 'dark') : t;

    const apply = (t: Mode, persist: boolean) => {
      if (persist) { try { localStorage.setItem('theme', t); } catch {} }
      const e = effective(t);
      document.documentElement.classList.toggle('light', e === 'light');
      document.querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', e === 'light' ? '#ffffff' : '#000000');
      btn!.textContent = LABELS[t] ?? t;
      btn!.setAttribute('aria-label', `Theme: ${t}`);
      /* 粒子引擎等监听此事件换配色 */
      window.dispatchEvent(new CustomEvent('themechange', { detail: { effective: e } }));
    };

    apply(read(), false);
    /* 跟随系统：系统切换时实时换装 */
    media.addEventListener('change', () => { if (read() === 'auto') apply('auto', false); });
    btn.addEventListener('click', () => {
      const next = ORDER[(ORDER.indexOf(read()) + 1) % ORDER.length];
      apply(next, true);
    });
  }
</script>
